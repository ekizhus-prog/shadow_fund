APP_PORT=8312
API_PORT=8412
DATABASE_PATH=./data/shadow-fund.sqlite
DATA_MODE=synthetic
NANSEN_API_KEY=
PROJECT_ID=shadow-fund
NANSEN_CREDIT_BUDGET=2500
NANSEN_RUN_CREDIT_LIMIT=150
NANSEN_DEMO_FULL_LANES=false
# Multi-chain bounded universe. Nansen Token Screener accepts up to five chains.
NANSEN_CHAINS=ethereum,base,solana,arbitrum
# Live collection guardrails: keep every non-premium lane active without a wide scan.
NANSEN_MAX_TOKENS=250
NANSEN_MAX_WALLETS=6
# Parallel request workers; this reduces wall time without widening the scan or credit budget.
NANSEN_CONCURRENCY=2
ENABLE_LLM=false
WORKER_INTERVAL_MS=21600000
WORKER_ONCE=false
